# ============================================================
# OneHealth Lens — .gitignore
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python virtual environments
.venv/
venv/
ENV/
env/
.env

# Unit test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover
*.py,cover
.cache

# ---------- Node / Vite ----------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite output
frontend/dist/
dist/
dist-ssr/
*.local

# Vite cache
.vite/
frontend/.vite/

# Vitest
.vitest/
coverage/
validator_cli.jar

# ============================================================
# Project-specific artifacts
# ============================================================

# SQLite database — regenerated by `python scripts/demo_persist.py`
onehealth.db
*.db
*.db-journal
*.sqlite
*.sqlite3

# Extracted FHIR bundle used in CI — never committed
ci-fhir-bundle.json
fhir-bundle.json
docs/fhir-bundle.json

# ============================================================
# Environment files — never commit secrets
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Editor and IDE
# ============================================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================================
# Operating system
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# Logs
# ============================================================
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Temporary files
# ============================================================
*.tmp
*.bak
*.orig
*.rej
*.pid
*.seed

# ============================================================
# Windows-specific
# ============================================================
$RECYCLE.BIN/
*.lnk
*.stackdump

# ============================================================
# KEEP (do NOT ignore — explicitly allow):
# ============================================================
# !data/mock_observations.json
# !docs/screenshots/*.png
# !scripts/demo_persist.py
# !requirements.txt
# !package.json
# !package-lock.json
# !pytest.ini
# !conftest.py
# !README.md
frontend/videos/*.mp4
frontend/videos/*.jpg
